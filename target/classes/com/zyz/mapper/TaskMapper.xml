<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyz.mapper.TaskMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.zyz.pojo.Task">
        <id column="id" property="id" />
        <result column="task_name" property="taskName" />
        <result column="client_id" property="clientId" />
        <result column="type" property="type" />
        <result column="prompt" property="prompt" />
        <result column="base64" property="base64" />
        <result column="video" property="video" />
        <result column="create_time" property="createTime" />
        <result column="task_id" property="taskId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, task_name, client_id, type, prompt, base64, video, create_time, task_id
    </sql>

</mapper>
